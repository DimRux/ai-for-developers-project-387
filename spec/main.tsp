import "@typespec/http";
import "@typespec/openapi";

using TypeSpec.Http;
using TypeSpec.OpenAPI;

/**
 * Booking Calendar API — лёгкий аналог cal.com.
 *
 * В системе две роли и нет ни регистрации, ни авторизации:
 *
 * - **Владелец календаря** — единственный заранее заданный профиль (`Owner`).
 *   Он создаёт типы событий (`EventType`) и просматривает единый список
 *   предстоящих встреч по всем типам событий.
 * - **Гость** — анонимный посетитель. Смотрит список видов брони, открывает
 *   календарь свободных слотов на 14 дней и создаёт бронирование (`Booking`)
 *   без создания аккаунта.
 *
 * Ключевое правило занятости: на одно и то же время нельзя создать две записи,
 * даже если это разные типы событий. Занятость считается по всему календарю
 * владельца, а не в рамках одного типа события.
 *
 * Окно записи: слоты формируются на `Owner.bookingWindowDays` (по умолчанию 14)
 * дней, начиная с текущего момента.
 */
@service(#{ title: "Booking Calendar API" })
@info(#{ version: "1.0.0" })
@server("/api/v1", "Базовый путь API")
@tagMetadata(
  "Owner",
  #{
    description: "Сценарии владельца календаря: создание типов событий и просмотр предстоящих встреч по всем типам событий.",
  }
)
@tagMetadata(
  "Guest",
  #{
    description: "Публичный сценарий гостя: просмотр видов брони, календарь свободных слотов на 14 дней и создание бронирования без регистрации.",
  }
)
namespace BookingCalendar;

// ---------------------------------------------------------------------------
// Общие типы
// ---------------------------------------------------------------------------

/** Часовой пояс в формате IANA, например `Europe/Moscow`. */
@example("Europe/Moscow")
scalar Timezone extends string;

/** Машиночитаемый код ошибки домена. */
union ErrorCode {
  /** Тело запроса или параметры не прошли валидацию. */
  ValidationError: "VALIDATION_ERROR",

  /** Запрошенный тип события не существует. */
  EventTypeNotFound: "EVENT_TYPE_NOT_FOUND",

  /** Тип события с таким `id` уже создан владельцем. */
  EventTypeIdConflict: "EVENT_TYPE_ID_CONFLICT",

  /** Бронирование не найдено. */
  BookingNotFound: "BOOKING_NOT_FOUND",

  /**
   * Выбранное время уже занято другим бронированием — возможно, другого типа
   * события. На одно и то же время нельзя создать две записи.
   */
  SlotTaken: "SLOT_TAKEN",

  /**
   * Выбранное время лежит вне окна записи `[сейчас; сейчас + bookingWindowDays)`
   * — например, в прошлом или дальше 14 дней.
   */
  SlotOutOfWindow: "SLOT_OUT_OF_WINDOW",

  /**
   * Выбранное время не попадает на сетку слотов: не кратно
   * `Owner.slotStepMinutes` либо встреча не укладывается в рабочие часы владельца.
   */
  SlotNotAligned: "SLOT_NOT_ALIGNED",
}

/** Стандартное тело ошибки. */
model ApiError {
  /** Машиночитаемый код ошибки. */
  code: ErrorCode;

  /** Человекочитаемое описание проблемы. */
  message: string;

  /** Дополнительный контекст ошибки (например, имя невалидного поля). */
  details?: Record<unknown>;
}

/** Ответ с ошибкой и конкретным HTTP-статусом. */
@error
model ErrorResponse<Status extends int32> {
  @statusCode statusCode: Status;
  @body error: ApiError;
}

/** Некорректный запрос: `VALIDATION_ERROR`, `SLOT_OUT_OF_WINDOW`, `SLOT_NOT_ALIGNED`. */
alias BadRequest = ErrorResponse<400>;

/** Ресурс не найден: `EVENT_TYPE_NOT_FOUND`, `BOOKING_NOT_FOUND`. */
alias NotFound = ErrorResponse<404>;

/** Конфликт состояния: `SLOT_TAKEN`, `EVENT_TYPE_ID_CONFLICT`. */
alias Conflict = ErrorResponse<409>;

/** Постраничный список. */
@friendlyName("Page{name}", T)
model Page<T> {
  /** Элементы текущей страницы. */
  items: T[];

  /** Общее количество элементов, подходящих под фильтры. */
  total: int32;

  /** Размер страницы, использованный при выборке. */
  limit: int32;

  /** Смещение от начала выборки. */
  offset: int32;
}

/** Параметры постраничной выборки. */
model PaginationQuery {
  /** Максимальное количество элементов в ответе. */
  @query
  @minValue(1)
  @maxValue(100)
  limit?: int32 = 20;

  /** Смещение от начала выборки. */
  @query
  @minValue(0)
  offset?: int32 = 0;
}

// ---------------------------------------------------------------------------
// Доменные сущности
// ---------------------------------------------------------------------------

/** Рабочие часы владельца внутри одного дня, в его часовом поясе. */
model WorkingHours {
  /** Время начала приёма, например `10:00:00`. */
  start: plainTime;

  /** Время окончания приёма, например `19:00:00`. Строго больше `start`. */
  end: plainTime;
}

/**
 * Владелец календаря — единственный заранее заданный профиль.
 * Регистрация и вход отсутствуют, поэтому профиль не создаётся через API,
 * а только читается: он определяет календарь, в который попадают все брони.
 */
model Owner {
  /** Идентификатор владельца. */
  @visibility(Lifecycle.Read)
  id: string;

  /** Отображаемое имя владельца. */
  name: string;

  /** Контактный email владельца. */
  @format("email")
  email: string;

  /** Часовой пояс владельца; в нём трактуются `workingHours`. */
  timezone: Timezone;

  /** Рабочие часы, внутри которых формируются слоты. */
  workingHours: WorkingHours;

  /** Шаг сетки слотов в минутах: допустимые значения начала встречи. */
  @minValue(5)
  @maxValue(240)
  slotStepMinutes: int32 = 30;

  /** Глубина окна записи в днях, начиная с текущей даты. */
  @minValue(1)
  @maxValue(365)
  bookingWindowDays: int32 = 14;
}

/**
 * Тип события — вид встречи, который создаёт владелец и выбирает гость.
 * Длительность типа события определяет длину слота и время окончания брони.
 */
model EventType {
  /**
   * Идентификатор типа события, задаваемый владельцем при создании.
   * Уникален и используется в публичных ссылках.
   */
  @minLength(1)
  @maxLength(64)
  id: string;

  /** Название, которое видит гость на странице видов брони. */
  @minLength(1)
  @maxLength(200)
  title: string;

  /** Описание встречи для гостя. */
  @maxLength(2000)
  description: string;

  /** Длительность встречи в минутах. */
  @minValue(1)
  @maxValue(1440)
  durationMinutes: int32;

  /** Момент создания типа события. */
  @visibility(Lifecycle.Read)
  createdAt: utcDateTime;
}

/** Данные для создания типа события владельцем. */
model EventTypeCreate {
  /** Идентификатор типа события, задаётся владельцем. */
  @minLength(1)
  @maxLength(64)
  id: string;

  /** Название типа события. */
  @minLength(1)
  @maxLength(200)
  title: string;

  /** Описание типа события. */
  @maxLength(2000)
  description: string;

  /** Длительность встречи в минутах. */
  @minValue(1)
  @maxValue(1440)
  durationMinutes: int32;
}

/**
 * Слот — вычисляемый интервал в календаре владельца. Слоты не хранятся:
 * они строятся с шагом `Owner.slotStepMinutes` внутри `Owner.workingHours`
 * на длину `EventType.durationMinutes`.
 */
model Slot {
  /** Начало слота. */
  start: utcDateTime;

  /** Окончание слота: `start + EventType.durationMinutes`. */
  end: utcDateTime;

  /**
   * Свободен ли слот. `false`, если слот пересекается с любым существующим
   * бронированием календаря — независимо от его типа события.
   */
  isAvailable: boolean;
}

/** Слоты одного календарного дня в часовом поясе владельца. */
model DaySlots {
  /** Дата дня в часовом поясе владельца. */
  date: plainDate;

  /** Слоты этого дня. Пустой массив, если свободного времени нет. */
  slots: Slot[];
}

/** Календарь свободных слотов для выбранного типа события. */
model SlotsResponse {
  /** Тип события, для которого построены слоты. */
  eventTypeId: string;

  /** Длительность встречи, использованная при построении слотов. */
  durationMinutes: int32;

  /** Часовой пояс владельца, в котором сгруппированы дни. */
  timezone: Timezone;

  /** Начало окна записи (по умолчанию — текущий момент). */
  windowStart: utcDateTime;

  /** Конец окна записи (по умолчанию — `windowStart + bookingWindowDays`). */
  windowEnd: utcDateTime;

  /** Дни окна записи по возрастанию, включая дни без свободных слотов. */
  days: DaySlots[];
}

/** Гость, создающий бронирование. Аккаунт не создаётся. */
model Guest {
  /** Имя гостя. */
  @minLength(1)
  @maxLength(200)
  name: string;

  /** Email гостя для подтверждения встречи. */
  @format("email")
  email: string;

  /** Необязательный комментарий к встрече. */
  @maxLength(2000)
  notes?: string;
}

/** Бронирование слота гостем. */
model Booking {
  /** Идентификатор бронирования. */
  id: string;

  /** Тип события, на который создана бронь. */
  eventTypeId: string;

  /** Название типа события на момент бронирования. */
  eventTypeTitle: string;

  /** Начало встречи. */
  start: utcDateTime;

  /** Окончание встречи: `start + EventType.durationMinutes`, считает сервер. */
  end: utcDateTime;

  /** Данные гостя. */
  guest: Guest;

  /** Момент создания бронирования. */
  createdAt: utcDateTime;
}

/** Данные для создания бронирования гостем. */
model BookingCreate {
  /**
   * Начало выбранного слота. Должно совпадать со `start` свободного слота из
   * `GET /event-types/{eventTypeId}/slots`. Время окончания вычисляет сервер.
   */
  start: utcDateTime;

  /** Данные гостя. */
  guest: Guest;
}

/** Какие встречи включать в список владельца. */
enum BookingScope {
  /** Только встречи, которые ещё не начались. Значение по умолчанию. */
  Upcoming: "upcoming",

  /** Только уже прошедшие встречи. */
  Past: "past",

  /** Все встречи без фильтра по времени. */
  All: "all",
}

// ---------------------------------------------------------------------------
// Сценарии владельца календаря
// ---------------------------------------------------------------------------

/**
 * Административная часть. Соответствует единственному заранее заданному
 * владельцу, поэтому не требует аутентификации и не принимает его идентификатор.
 */
@route("/admin")
@tag("Owner")
namespace Admin {
  /**
   * Профиль владельца календаря.
   *
   * Возвращает заранее заданный профиль, который по умолчанию используется в
   * административной части: его часовой пояс, рабочие часы, шаг сетки слотов и
   * глубину окна записи.
   */
  @summary("Получить профиль владельца календаря")
  @route("/owner")
  @get
  op getOwner(): Owner;

  /**
   * Создание типа события.
   *
   * Владелец задаёт `id`, название, описание и длительность в минутах.
   * Длительность определяет длину слота для гостя.
   */
  @summary("Создать тип события")
  @route("/event-types")
  @post
  op createEventType(@body eventType: EventTypeCreate):
    | {
        @statusCode statusCode: 201;
        @body created: EventType;
      }
    | BadRequest
    | Conflict;

  /**
   * Список типов событий владельца, отсортированный по `createdAt` по убыванию.
   */
  @summary("Получить список типов событий")
  @route("/event-types")
  @get
  op listEventTypes(...PaginationQuery): Page<EventType> | BadRequest;

  /**
   * Страница предстоящих встреч.
   *
   * Единый список бронирований по всем типам событий, отсортированный по
   * времени начала по возрастанию. По умолчанию возвращаются только встречи,
   * которые ещё не начались (`scope=upcoming`).
   */
  @summary("Получить список встреч по всем типам событий")
  @route("/bookings")
  @get
  op listBookings(
    /** Какие встречи включать в выборку. */
    @query scope?: BookingScope = BookingScope.Upcoming,

    /** Включать встречи, начинающиеся не раньше указанного момента. */
    @query from?: utcDateTime,

    /** Включать встречи, начинающиеся раньше указанного момента. */
    @query to?: utcDateTime,

    /** Необязательный фильтр по одному типу события. */
    @query eventTypeId?: string,

    ...PaginationQuery,
  ): Page<Booking> | BadRequest;
}

// ---------------------------------------------------------------------------
// Публичный сценарий гостя
// ---------------------------------------------------------------------------

/**
 * Публичная часть для гостя. Не требует регистрации, авторизации и создания
 * аккаунта: гость видит виды брони, календарь свободных слотов и создаёт бронь.
 */
@tag("Guest")
namespace Public {
  /**
   * Страница видов брони.
   *
   * Возвращает все типы событий владельца с названием, описанием и
   * длительностью, чтобы гость мог выбрать нужный вид встречи.
   */
  @summary("Получить список видов брони")
  @route("/event-types")
  @get
  op listEventTypes(): EventType[];

  /**
   * Карточка выбранного типа события перед открытием календаря.
   */
  @summary("Получить тип события")
  @route("/event-types/{eventTypeId}")
  @get
  op getEventType(
    /** Идентификатор типа события. */
    @path eventTypeId: string,
  ): EventType | NotFound;

  /**
   * Календарь свободных слотов выбранного типа события.
   *
   * Слоты формируются на окно записи `[from; to)`, по умолчанию — на
   * `Owner.bookingWindowDays` (14) дней, начиная с текущего момента.
   * Внутри окна берутся только интервалы, кратные `Owner.slotStepMinutes`,
   * целиком укладывающиеся в `Owner.workingHours` и не пересекающиеся ни с
   * одним существующим бронированием календаря — включая брони других типов
   * событий.
   *
   * Ошибки: `400 SLOT_OUT_OF_WINDOW`, если `from`/`to` выходят за окно записи
   * или `to` не больше `from`; `404 EVENT_TYPE_NOT_FOUND`.
   */
  @summary("Получить свободные слоты на окно записи")
  @route("/event-types/{eventTypeId}/slots")
  @get
  op listSlots(
    /** Идентификатор типа события. */
    @path eventTypeId: string,

    /** Начало запрашиваемого окна. По умолчанию — текущий момент. */
    @query from?: utcDateTime,

    /**
     * Конец запрашиваемого окна. По умолчанию — `from + bookingWindowDays`
     * (14 дней). Не может выходить за границу окна записи.
     */
    @query to?: utcDateTime,

    /** Возвращать только свободные слоты. При `false` слоты приходят с `isAvailable`. */
    @query onlyAvailable?: boolean = true,
  ): SlotsResponse | BadRequest | NotFound;

  /**
   * Создание бронирования на выбранный слот.
   *
   * Гость передаёт только время начала и свои контакты — время окончания
   * сервер вычисляет по длительности типа события.
   *
   * Ошибки:
   * - `400 SLOT_OUT_OF_WINDOW` — время вне окна `[сейчас; сейчас + 14 дней)`;
   * - `400 SLOT_NOT_ALIGNED` — время не на сетке слотов или встреча не
   *   укладывается в рабочие часы владельца;
   * - `400 VALIDATION_ERROR` — некорректные данные гостя;
   * - `404 EVENT_TYPE_NOT_FOUND` — тип события не существует;
   * - `409 SLOT_TAKEN` — время уже занято другой записью, в том числе записью
   *   другого типа события.
   */
  @summary("Создать бронирование на свободный слот")
  @route("/event-types/{eventTypeId}/bookings")
  @post
  op createBooking(
    /** Идентификатор типа события. */
    @path eventTypeId: string,

    @body booking: BookingCreate,
  ):
    | {
        @statusCode statusCode: 201;
        @body created: Booking;
      }
    | BadRequest
    | NotFound
    | Conflict;

  /**
   * Страница подтверждения: детали созданного бронирования.
   */
  @summary("Получить бронирование")
  @route("/bookings/{bookingId}")
  @get
  op getBooking(
    /** Идентификатор бронирования. */
    @path bookingId: string,
  ): Booking | NotFound;
}
